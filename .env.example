LLM_API_KEY=your_api_key_here
LLM_BASE_URL=
LLM_MODEL=
# Keep tiny for the current default workflow.
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# For English videos, setting SOURCE_LANGUAGE=en usually keeps the original text
# closer to the audio. Bilingual subtitles render Chinese on line 1 and the
# original English on line 2.
SOURCE_LANGUAGE=
TRANSLATION_BATCH_SIZE=12
OUTPUT_DIR=output
# Subtitle segmentation settings (Netflix/BBC/DCMP-inspired).
# max_cps: reading-speed cap in characters per second (~15 ≈ 170 wpm).
#   A subtitle is split only when its text/duration ratio exceeds this cap.
# min_duration: minimum on-screen duration in seconds; shorter raw segments
#   are merged into neighbors (borrowing time). Netflix minimum ≈ 0.8s.
# max_duration: maximum on-screen duration in seconds (6-second rule).
# min_gap: gaps between consecutive subtitles smaller than this (seconds)
#   are closed by extending the previous subtitle (chaining). Netflix: <0.5s.
# gap_close: set to false to keep the original timeline and skip gap closing.
SUBTITLE_MAX_CPS=15.0
SUBTITLE_MIN_DURATION=0.8
SUBTITLE_MAX_DURATION=6.0
SUBTITLE_MIN_GAP=0.5
SUBTITLE_GAP_CLOSE=true
